{
  "name": "storybook-addon-colab",
  "version": "0.0.0",
  "description": "Lay out live stories on a canvas, pin comments to DOM elements, draw on top, and let a coding agent read and reply over MCP",
  "keywords": [
    "storybook-addon",
    "storybook-addons",
    "canvas",
    "comments",
    "annotations",
    "design-review",
    "mcp",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/winkervsbecks/addon-colab"
  },
  "bugs": "https://github.com/winkervsbecks/addon-colab/issues",
  "license": "MIT",
  "author": "Varun Vachhar",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "manager.js",
    "preset.js",
    "preview.js"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build-storybook": "storybook build",
    "check:browser": "node scripts/run-browser-checks.mjs",
    "build:watch": "npm run build -- --watch",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@storybook/addon-docs": "11.0.0-rc.0",
    "@storybook/icons": "2.2.0",
    "@storybook/react-vite": "11.0.0-rc.0",
    "@types/node": "^22.12.0",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "11.0.0-rc.0",
    "happy-dom": "^20.14.6",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "1.65.1",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "11.0.0-rc.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.0.5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "storybook": "^11.0.0-rc.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Colab Canvas",
    "supportedFrameworks": [
      "react-vite"
    ]
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
